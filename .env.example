# ==============================================================================
# ASTRA — Smart Farmer Procurement Coordination Platform
# Environment Variables Template
#
# Copy this file to .env before starting the development environment:
# cp .env.example .env
# ==============================================================================

# Node Environment (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=3001

# PostgreSQL Database (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/astra_dev?schema=public
# Example docker: postgresql://postgres:postgres@postgres:5432/astra_dev?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra_dev?schema=public

# Redis Connection (Fast/temporary state & live queue cache)
# Example local: redis://localhost:6379
# Example docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Authentication & Session Security (JWT)
# Generate a strong 256-bit random key for production
JWT_SECRET=astra_dev_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Application Configuration (apps/web)
# ------------------------------------------------------------------------------
# Base API URL consumed by Next.js client & server components
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
