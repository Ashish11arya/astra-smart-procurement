generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemHealth {
  id        String   @id @default(uuid())
  probeKey  String   @unique
  checkedAt DateTime @default(now())
  status    String   @default("ok")
}

model User {
  id                   String                      @id @default(uuid())
  mobile               String                      @unique
  role                 UserRole                    @default(FARMER)
  isActive             Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  name                 String?
  personnelAssignments CentrePersonnelAssignment[]
  farmer               Farmer?

  @@index([mobile])
}

model Farmer {
  id                 String               @id @default(uuid())
  userId             String               @unique
  farmerCode         String               @unique
  fullName           String
  fatherOrSpouseName String?
  gender             Gender?
  category           FarmerCategory?
  mobile             String
  isVerified         Boolean              @default(false)
  village            String?
  district           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations      FarmerRegistration[]
  verification       FarmerVerification?
  bookings           ProcurementBooking[]

  @@index([mobile])
  @@index([farmerCode])
}

model FarmerRegistration {
  id                  String             @id @default(uuid())
  registrationNumber  String             @unique
  farmerId            String
  status              RegistrationStatus @default(DRAFT)
  submittedAt         DateTime?
  verifiedAt          DateTime?
  actionRequiredNotes String?
  rejectionReason     String?
  personalDetails     Json?
  addressDetails      Json?
  bankDetails         Json?
  documents           Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reason              String?
  rejectedAt          DateTime?
  rejectedBy          String?
  returnedAt          DateTime?
  returnedBy          String?
  verifiedBy          String?
  farmer              Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  landParcels         LandParcel[]

  @@index([farmerId])
  @@index([registrationNumber])
  @@index([status])
}

model FarmerVerification {
  id          String             @id @default(uuid())
  farmerId    String             @unique
  status      RegistrationStatus @default(VERIFICATION_PENDING)
  submittedAt DateTime           @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?
  rejectedAt  DateTime?
  rejectedBy  String?
  returnedAt  DateTime?
  returnedBy  String?
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  farmer      Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([farmerId])
}

model LandParcel {
  id             String             @id @default(uuid())
  registrationId String
  district       String
  block          String
  panchayat      String
  village        String
  khasraNumber   String
  areaAcres      Float
  ownershipType  LandOwnershipType  @default(OWNER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  registration   FarmerRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model State {
  id        String              @id @default(uuid())
  name      String
  code      String              @unique
  isActive  Boolean             @default(true)
  districts District[]
  centres   ProcurementCentre[]
}

model District {
  id       String              @id @default(uuid())
  stateId  String
  name     String
  code     String              @unique
  isActive Boolean             @default(true)
  state    State               @relation(fields: [stateId], references: [id], onDelete: Cascade)
  centres  ProcurementCentre[]

  @@index([stateId])
}

model ProcurementCentre {
  id                         String                      @id @default(uuid())
  centreCode                 String                      @unique
  name                       String
  stateId                    String
  districtId                 String
  block                      String?
  address                    String
  latitude                   Float
  longitude                  Float
  agency                     String                      @default("Food & Civil Supplies Corporation")
  operatingDays              String                      @default("Monday - Saturday")
  operatingHoursStart        String                      @default("08:00")
  operatingHoursEnd          String                      @default("17:00")
  morningCapacityQuintals    Float                       @default(300.0)
  afternoonCapacityQuintals  Float                       @default(250.0)
  maxHourlyCapacityQuintals  Float                       @default(60.0)
  slotDurationMinutes        Int                         @default(15)
  maxQuantityPerBooking      Float                       @default(150.0)
  verificationStatus         CentreVerificationStatus    @default(PENDING_VERIFICATION)
  operationalStatus          CentreOperationalStatus     @default(OPEN)
  contactPhone               String?
  contactEmail               String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  centreDailyFarmerLimit     Float                       @default(50.0)
  minBookingQuantityQuintals Float                       @default(10.0)
  auditLogs                  AuditLog[]
  capacityAudits             CentreCapacityAudit[]
  counters                   CentreCounter[]
  personnel                  CentrePersonnelAssignment[]
  bookings                   ProcurementBooking[]
  district                   District                    @relation(fields: [districtId], references: [id])
  state                      State                       @relation(fields: [stateId], references: [id])

  @@index([stateId])
  @@index([districtId])
  @@index([verificationStatus, operationalStatus])
}

model CentreCounter {
  id            String            @id @default(uuid())
  centreId      String
  counterNumber Int
  counterName   String
  status        CounterStatus     @default(AVAILABLE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  centre        ProcurementCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([centreId])
}

model CentrePersonnelAssignment {
  id         String            @id @default(uuid())
  userId     String
  centreId   String
  role       UserRole
  department String
  isActive   Boolean           @default(true)
  assignedAt DateTime          @default(now())
  centre     ProcurementCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, centreId])
  @@index([userId])
  @@index([centreId])
}

model ProcurementBooking {
  id                         String                     @id @default(uuid())
  bookingNumber              String                     @unique
  farmerId                   String
  centreId                   String
  bookingDate                DateTime
  session                    BookingSession
  windowStartTime            String
  windowEndTime              String
  expectedQuantityQuintals   Float
  maxAllowedQuantityQuintals Float                      @default(150.0)
  expectedDurationMinutes    Int                        @default(25)
  vehicleNumber              String?
  vehicleType                String?
  driverName                 String?
  status                     BookingStatus              @default(BOOKED)
  checkInTime                DateTime?
  idempotencyKey             String?                    @unique
  cancellationReason         String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  applicableLimitAtBooking   Float?
  centreLimitAtBooking       Float?
  governmentLimitAtBooking   Float?
  minimumBookingAtBooking    Float?
  auditLogs                  AuditLog[]
  payment                    PaymentSettlementRecord?
  centre                     ProcurementCentre          @relation(fields: [centreId], references: [id], onDelete: Cascade)
  farmer                     Farmer                     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  procurement                ProcurementDecisionRecord?
  quality                    QualityAssessmentRecord?
  weighment                  WeighmentRecord?

  @@index([centreId, bookingDate, session])
  @@index([farmerId])
  @@index([bookingNumber])
  @@index([status])
}

model WeighmentRecord {
  id                     String             @id @default(uuid())
  bookingId              String             @unique
  deviceCode             String             @default("Scale-01")
  originalHardwareWeight Float
  approvedFinalWeight    Float?
  status                 WeighmentStatus    @default(RECORDED)
  correctionReason       String?
  officerRemarks         String?
  requestedBy            String?
  requestedAt            DateTime?
  approvedBy             String?
  approvedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  booking                ProcurementBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model QualityAssessmentRecord {
  id                   String             @id @default(uuid())
  bookingId            String             @unique
  moisturePercent      Float
  foreignMatterPercent Float
  damagedGrainPercent  Float
  grade                QualityGrade       @default(GRADE_A)
  remarks              String?
  assessedBy           String
  assessedAt           DateTime           @default(now())
  booking              ProcurementBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ProcurementDecisionRecord {
  id                       String              @id @default(uuid())
  bookingId                String              @unique
  decision                 ProcurementDecision @default(ACCEPTED)
  acceptedQuantityQuintals Float
  ratePerQuintal           Float               @default(2325.0)
  totalAmount              Float
  remarks                  String?
  decidedBy                String
  decidedAt                DateTime            @default(now())
  booking                  ProcurementBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PaymentSettlementRecord {
  id                String             @id @default(uuid())
  bookingId         String             @unique
  paymentStatus     PaymentStatus      @default(PENDING)
  transactionRef    String?
  bankAccountMasked String?
  amount            Float
  settledBy         String?
  settledAt         DateTime?
  booking           ProcurementBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model AuditLog {
  id            String              @id @default(uuid())
  eventType     String
  bookingId     String?
  centreId      String?
  actorId       String
  actorRole     String
  previousState Json?
  newState      Json?
  reason        String?
  createdAt     DateTime            @default(now())
  booking       ProcurementBooking? @relation(fields: [bookingId], references: [id])
  centre        ProcurementCentre?  @relation(fields: [centreId], references: [id])

  @@index([bookingId])
  @@index([centreId])
  @@index([actorId])
  @@index([eventType])
}

model CentreCapacityAudit {
  id            String            @id @default(uuid())
  centreId      String
  changedBy     String
  changedAt     DateTime          @default(now())
  fieldChanged  String
  oldValue      Float
  newValue      Float
  crop          String            @default("Paddy")
  season        String            @default("Kharif 2026")
  effectiveDate DateTime          @default(now())
  reason        String?
  centre        ProcurementCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([centreId])
  @@index([changedAt])
}

enum UserRole {
  FARMER
  CHECK_IN
  WEIGHMENT
  QUALITY
  PROCUREMENT
  PAYMENT
  GOVERNMENT_ADMIN
  PROCUREMENT_CENTRE_OFFICER
  CHECK_IN_OFFICER
  WEIGHMENT_OFFICER
  WEIGHMENT_SUPERVISOR
  QUALITY_OFFICER
  PROCUREMENT_OFFICER
  PAYMENT_OFFICER
  FARMER_VERIFICATION_AUTHORITY
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_VERIFICATION
  ACTION_REQUIRED
  VERIFIED
  REJECTED
  VERIFICATION_PENDING
  RETURNED_FOR_CORRECTION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FarmerCategory {
  GENERAL
  OBC
  SC
  ST
}

enum LandOwnershipType {
  OWNER
  TENANT
  SHARECROPPER
}

enum CentreVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CentreOperationalStatus {
  OPEN
  CLOSED
  TEMPORARILY_UNAVAILABLE
  MAINTENANCE
}

enum CounterStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
}

enum BookingSession {
  MORNING
  AFTERNOON
}

enum BookingStatus {
  PENDING
  BOOKED
  CANCELLED
  NO_SHOW
  CHECKED_IN
  WEIGHMENT
  QUALITY_ASSESSMENT
  PROCUREMENT
  PAYMENT
  COMPLETED
}

enum WeighmentStatus {
  WAITING
  DEVICE_CONNECTED
  READING_RECEIVED
  RECORDED
  CORRECTION_PENDING
  CORRECTION_APPROVED
  CORRECTION_REJECTED
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  REJECTED
}

enum ProcurementDecision {
  ACCEPTED
  REJECTED
  PARTIAL_ACCEPTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
}
